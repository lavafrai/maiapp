FROM azul/zulu-openjdk-alpine:25-latest AS build

COPY . /opt/app/
WORKDIR /opt/app

RUN chmod +x gradlew
RUN ./gradlew --warning-mode all :server:buildFatJar

FROM azul/zulu-openjdk-alpine:25-latest

RUN apk --no-cache add curl
COPY --from=build /opt/app/server/build/libs/server-all.jar /opt/app/server.jar
WORKDIR /opt/app
# Without native access Netty can't free direct buffers itself on JDK 24+ and leaves it to GC
CMD java --enable-native-access=ALL-UNNAMED -jar server.jar
